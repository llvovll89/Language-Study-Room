{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/pre-commit-check.mjs\"",
            "timeout": 120,
            "statusMessage": "커밋 전 데이터 검증과 단위 테스트 실행 중..."
          }
        ]
      }
    ]
  }
}
